tmp --> uc14
src --> uc14
ana --> uc15
ana --> uc16
ana --> uc17
ana --> uc18
ana --> uc19
aud --> uc19
ana --> uc20
aud --> uc20

uc14 ..> uc14a : <<include>>
uc14b .up.> uc14 : <<extend>>
uc14c .up.> uc14 : <<extend>>
uc15a .up.> uc15 : <<extend>>
uc15b .up.> uc15 : <<extend>>
uc15c .up.> uc15a : <<extend>>
uc14a ..> rec : <<include>>
uc15b ..> rec : <<include>>
uc18 ..> uc18a : <<include>>
uc18 ..> uc14a : <<include>>
uc17 ..> uc20 : <<include>>
