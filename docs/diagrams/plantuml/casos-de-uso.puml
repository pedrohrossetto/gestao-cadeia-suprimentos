' Diagramas de casos de uso (PlantUML). Equivalente a docs/casos-de-uso.md (Mermaid).
' Gerar PNGs: plantuml -tpng docs/casos-de-uso.puml  (um arquivo por @startuml, nomeado pelo identificador)

@startuml uc0-visao-geral
title 0. Visão geral
left to right direction
skinparam packageStyle rectangle

actor "Administrador" as adm
actor "Analista de\nConformidade" as ana
actor "Operador de Lotes" as ope
actor "Auditor" as aud
actor "Temporizador" as tmp <<sistema>>
actor "SICAR / Ibama /\nICMBio / Lista suja" as src <<externo>>
actor "APIs de satélite\ne desmatamento" as sat <<externo>>
actor "ERP / Telemetria" as erp <<externo>>
actor "Sistema do comprador" as comp <<externo>>

adm --|> ana

rectangle "Sistema de Gestão da Cadeia de Suprimentos" {
  usecase "Gerir fornecedores\ne propriedades" as m1
  usecase "Gerir lotes e\nrastreabilidade" as m2
  usecase "Gerir conformidade" as m3
  usecase "Gerir risco e DDS" as m4
  usecase "Visualizar dados\ngeoespaciais" as m5
  usecase "Administrar e auditar" as m6
}

ope --> m1
ana --> m1
ope --> m2
ana --> m3
ana --> m4
ope --> m4
ope --> m5
ana --> m5
aud --> m5
adm --> m6
aud --> m6
tmp --> m3
src --> m3
sat --> m5
erp --> m2
comp --> m4
@enduml

@startuml uc1-fornecedores-propriedades
title 1. Fornecedores e propriedades
left to right direction
skinparam packageStyle rectangle

actor "Operador de Lotes" as ope
actor "Analista de\nConformidade" as ana
actor "Auditor" as aud

rectangle "Fornecedores e propriedades" {
  usecase "UC01 Cadastrar fornecedor" as uc1
  usecase "UC02 Cadastrar propriedade" as uc2
  usecase "UC03 Importar geometria\nde propriedades" as uc3
  usecase "Validar geometria e converter\npara EPSG:4326" as uc3a
  usecase "Informar erros da importação" as uc3b
  usecase "UC04 Gerenciar Áreas" as uc4
  usecase "UC05 Registrar grupo econômico\ne parentesco" as uc5
  usecase "UC06 Consultar detalhe de\nfornecedor/propriedade" as uc6
  usecase "Exibir status dos critérios" as uc6a
}

ope --> uc1
ope --> uc2
ope --> uc3
ope --> uc4
ana --> uc5
ope --> uc6
ana --> uc6
aud --> uc6

uc2 ..> uc3a : <<include>>
uc3 ..> uc3a : <<include>>
uc6 ..> uc6a : <<include>>
uc3b .up.> uc3 : <<extend>>
@enduml

@startuml uc2-lotes-rastreabilidade
title 2. Lotes e rastreabilidade
left to right direction
skinparam packageStyle rectangle

actor "Operador de Lotes" as ope
actor "Auditor" as aud
actor "ERP / Telemetria" as erp <<externo>>

rectangle "Lotes e rastreabilidade" {
  usecase "UC07 Cadastrar lote" as uc7
  usecase "UC08 Registrar mistura\nou transformação" as uc8
  usecase "UC09 Transferir lote\nentre fornecedores" as uc9
  usecase "UC10 Dar baixa no\ndestino final" as uc10
  usecase "UC11 Gerar passaporte digital" as uc11
  usecase "Exportar em PDF ou JSON" as uc11a
  usecase "UC12 Sincronizar lotes com\nERP/telemetria" as uc12
  usecase "UC13 Consultar balanço de massa\ne origem do lote" as uc13
  usecase "Verificar saldo e\nregras de massa" as chk
}

ope --> uc7
ope --> uc8
ope --> uc9
ope --> uc10
ope --> uc11
ope --> uc13
aud --> uc11
aud --> uc13
erp --> uc12

uc7 ..> chk : <<include>>
uc8 ..> chk : <<include>>
uc9 ..> chk : <<include>>
uc10 ..> chk : <<include>>
uc12 ..> uc7 : <<include>>
uc11a .up.> uc11 : <<extend>>
@enduml

@startuml uc3-conformidade
