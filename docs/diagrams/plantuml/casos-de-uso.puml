  usecase "Usar última resposta\nem caso de falha" as uc14b
  usecase "Notificar mudança de\nsituação do CAR" as uc14c
  usecase "UC15 Gerenciar critérios\ndo usuário" as uc15
  usecase "Criar critério" as uc15a
  usecase "Editar, desativar ou\narquivar critério" as uc15b
  usecase "Simular critério" as uc15c
  usecase "UC16 Definir perfil\nde validação" as uc16
  usecase "UC17 Validar lote" as uc17
  usecase "UC18 Alterar status de critério\nmanualmente" as uc18
  usecase "Anexar justificativa\ne documento" as uc18a
  usecase "UC19 Consultar status\nem data passada" as uc19
  usecase "UC20 Consultar distribuição\nde massa do lote" as uc20
